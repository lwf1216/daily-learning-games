{
  "name": "daily-learning-games",
  "private": true,
  "version": "1.0.0",
  "description": "A browser-local 30-day Chinese, Maths and English learning check-in site.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "node scripts/verify-content.mjs",
    "check": "npm run lint && npm run verify && npm run build",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wrangler": "^4.118.0"
  }
}
