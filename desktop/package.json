{
  "name": "daily-learning-games-desktop",
  "version": "1.0.0",
  "description": "语数英每日打卡 - Windows 桌面版",
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dailylearning.games",
    "productName": "每日打卡",
    "files": ["main.js", "web/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "每日打卡"
    }
  }
}